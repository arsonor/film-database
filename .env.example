# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/film_database

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App
APP_ENV=development
APP_PORT=8000

# Admin auth (set a strong random string for production)
ADMIN_SECRET_KEY=

# CORS (comma-separated origins, for production add your Vercel domain)
CORS_ORIGINS=http://localhost:3000

# Enrichment model (Step 23). Alternatives:
#   claude-haiku-4-5  — cheap bulk passes ($1/$5 per MTok)
#   claude-opus-5     — highest quality ($5/$25 per MTok)
# Sonnet 5 is $2/$10 introductory through 2026-08-31, then $3/$15.
CLAUDE_ENRICHMENT_MODEL=claude-sonnet-5
# "disabled" (default) or "adaptive". Sonnet 5 thinks by default when the
# parameter is omitted; disabled keeps cost and max_tokens predictable.
CLAUDE_ENRICHMENT_THINKING=disabled
